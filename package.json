{
  "name": "video-analyse-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform sports video analysis",
  "author": "Video Analyse",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.videoanalyse.ts",
    "productName": "Video Analyse TS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@resvg/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "mac": {
      "icon": "build-assets/app_icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.sports",
      "minimumSystemVersion": "14.0",
      "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "package.json",
        "!**/.cache/**/*",
        "!node_modules/ffprobe-static/bin/linux/**/*",
        "!node_modules/ffprobe-static/bin/win32/**/*",
        "!node_modules/ffprobe-static/bin/darwin/x64/**/*"
      ]
    },
    "win": {
      "icon": "build-assets/app_icon.ico",
      "target": [
        "nsis"
      ],
      "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "package.json",
        "!**/.cache/**/*",
        "!node_modules/ffprobe-static/bin/darwin/**/*",
        "!node_modules/ffprobe-static/bin/linux/**/*",
        "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
